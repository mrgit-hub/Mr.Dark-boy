            ).catch(() => {});
        }
    });
});

/* ---------------- HEARTBEAT (20s) ---------------- */

setInterval(function () {
    appSocket.clients.forEach(function (ws) {
        if (ws.isAlive === false) {
            try { ws.terminate(); } catch (e) {}
            return;
        }
        ws.isAlive = false;
        try { ws.ping(); } catch (e) {}
        try { ws.send('ping'); } catch (e) {}
    });
    cleanStaleClients();
}, 20000);

