/* ---------------- HELPER ---------------- */

function sendToUuid(uuid, payload) {
    if (!uuid) return false;
    let sent = false;
    appSocket.clients.forEach(function (ws) {
        if (ws.uuid == uuid && ws.readyState === 1) {
            try { ws.send(payload); sent = true; } catch (e) {}
        }
    });
    return sent;
}

